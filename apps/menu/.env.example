# API origin. In `npm run dev` / `vite preview` this is the proxy target for /api (the browser calls the Vite
# origin, so the Host header {slug}.localhost:5174 reaches the API). In a production build the app calls this
# origin directly; leave it empty to call /api on the same origin as the menu (reverse-proxy setup).
VITE_API_URL=http://localhost:3000
# Restaurant to show when the host has no subdomain (plain http://localhost:5174). Dev convenience only.
VITE_DEFAULT_SLUG=kafeterija
# Optional: dev/preview proxy target when it differs from VITE_API_URL (e.g. VITE_API_URL empty to test the
# same-origin production setup through the preview proxy).
# API_PROXY_TARGET=http://localhost:3000
