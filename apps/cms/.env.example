# API origin. In `npm run dev` / `vite preview` this is the proxy target for /api (the browser calls the Vite
# origin at http://localhost:5173, which is the API's APP_URL, so magic links land here). In a production build
# the app calls this origin directly; leave it empty to call /api on the same origin as the CMS.
VITE_API_URL=http://localhost:3100
# Optional: public menu URL template used for "View live menu" before the restaurant has loaded.
# VITE_PUBLIC_MENU_BASE_URL=http://{slug}.localhost:5174
# Optional: dev/preview proxy target when it differs from VITE_API_URL.
# API_PROXY_TARGET=http://localhost:3100
