# ───────── Server ─────────
NODE_ENV=development
PORT=3000
# pino level: trace | debug | info | warn | error | silent
LOG_LEVEL=debug
# Set to 1 behind a reverse proxy / load balancer so client IPs and HTTPS are detected
TRUST_PROXY=0
# Build identifier reported by GET /api/health (the Docker image bakes in the git short SHA; "dev" when unset)
APP_VERSION=

# ───────── Database ─────────
DATABASE_URL=postgres://tabla:tabla@localhost:5432/tabla
# Used by `npm test`. Defaults to DATABASE_URL with the database name suffixed "_test" (created automatically).
TEST_DATABASE_URL=postgres://tabla:tabla@localhost:5432/tabla_test
# Set to true for managed Postgres that requires SSL (e.g. DigitalOcean)
DATABASE_SSL=false

# ───────── Auth ─────────
# Long random string (openssl rand -base64 48). Signs short-lived access tokens.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds (default 15 minutes)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token (httpOnly cookie) lifetime in days
JWT_REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=tabla_refresh

# ───────── URLs ─────────
# CMS frontend; used for magic-link / password-reset links and allowed for CORS with credentials
APP_URL=http://localhost:5173
# This API's public URL; used to build URLs for locally stored uploads
API_URL=http://localhost:3000
# Public menu URL template. {slug} is replaced by the restaurant slug. Production: https://{slug}.otvori.menu
PUBLIC_MENU_BASE_URL=http://{slug}.localhost:5174
# Extra comma-separated origins allowed by CORS (APP_URL and the public menu domain are always allowed)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ───────── Storage (AWS S3 in production; any S3-compatible service via S3_ENDPOINT) ─────────
# Leave S3_BUCKET empty to store uploads on disk in UPLOADS_DIR (served at API_URL/uploads).
# AWS: S3_ENDPOINT empty, S3_REGION=eu-central-1, bucket otvori-media (public read through the bucket policy on
# restaurants/*). Spaces: S3_ENDPOINT=https://fra1.digitaloceanspaces.com, S3_REGION=fra1 (objects get ACL public-read).
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for image links (bucket host or CDN), e.g. https://otvori-media.s3.eu-central-1.amazonaws.com.
# Empty = derived from bucket + region/endpoint. (S3_PUBLIC_URL is the older name and still works.)
S3_PUBLIC_BASE_URL=
UPLOADS_DIR=./uploads

# ───────── Mail ─────────
# log = messages only go to the log (development/test); resend = send through https://resend.com (needs RESEND_API_KEY)
MAIL_PROVIDER=log
RESEND_API_KEY=
MAIL_FROM="otvori <zdravo@otvori.menu>"

# Run pending migrations before the server listens. Unset = on in production (the container does it on start), off otherwise.
MIGRATE_ON_START=

# ── Feature flags (Phase 10) ───────────────────────────────────────────────────────────────────────────────────
# Global switches above the per-venue modules; reported by GET /api/health and GET /api/config.
# FEATURE_PAYMENTS defaults to false (production keeps it off until the bank integration ships); set true locally
# to work on payments. FEATURE_POS defaults to true.
FEATURE_PAYMENTS=true
FEATURE_POS=true

# ── Online payment (Phase 9c) ──────────────────────────────────────────────────────────────────────────────────
# PAYMENTS_MOCK=true enables the mock provider and the simulator page GET /dev/pay/:ref (ignored in production:
# the API forces it to false there).
PAYMENTS_MOCK=true
# Key for merchant secrets / POS API keys at rest (AES-256-GCM): `openssl rand -base64 32`. Outside production a
# key derived from JWT_ACCESS_SECRET is used when unset.
PAYMENTS_ENCRYPTION_KEY=
# OTP eCommerce gateway base URL (sandbox or production); unset = the OTP provider reports "not configured".
OTP_ECOM_BASE_URL=

# ── POS integration (Phase 9d) ─────────────────────────────────────────────────────────────────────────────────
# POS_MOCK=true enables the mock register (logs what would be sent, returns fake fiscal receipts); forced off in production.
POS_MOCK=true
# Octopos sandbox, used only by the live integration tests (apps/api/test/pos.test.ts); OCTOPOS_SANDBOX_AUTH is the
# full Authorization header value. Never printed.
OCTOPOS_SANDBOX_URL=
OCTOPOS_SANDBOX_AUTH=
