{
  "name": "@qr-menu/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit -p tsconfig.json",
    "lint": "prettier --check \"src/**/*.{astro,ts,css}\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icons.mjs",
    "og": "tsx scripts/og.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@tailwindcss/vite": "^4.3.3",
    "cookie": "^2.0.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "vitest": "^5.0.5"
  }
}
