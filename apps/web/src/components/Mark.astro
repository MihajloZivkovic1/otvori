---
/**
 * The otvori mark (design/otvori-brand.html): a QR finder square whose right side has swung open toward the viewer.
 * 32-unit grid, frame stroke 3.2, inner square 8, door hinged at x=24.5. Draws in `currentColor`.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false" class={className}>
  <path
    d="M23 6H9a3 3 0 0 0-3 3v14a3 3 0 0 0 3 3h14"
    fill="none"
    stroke="currentColor"
    stroke-width="3.2"
    stroke-linejoin="round"
  ></path>
  <rect x="11.3" y="12" width="8" height="8" rx="1.5" fill="currentColor"></rect>
  <path d="M24.5 6.4 30 2.2v27.6l-5.5-4.2z" fill="currentColor"></path>
</svg>
