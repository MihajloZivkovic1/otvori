---
import { contact } from '../config';
import type { Dictionary } from '../i18n';
import Wordmark from './Wordmark.astro';
interface Props {
  t: Dictionary;
  /** Prefix for the `#section` links; '' on the landing page, the landing path ('/') elsewhere. */
  home?: string;
}
const { t, home = '' } = Astro.props;
---

<footer class="flex flex-col gap-6 border-t border-ink/8 px-5 pt-9 pb-10 lg:grid lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-12 lg:px-20 lg:pt-12 xl:px-[120px]">
  <div class="flex flex-col gap-3 lg:gap-3.5">
    <Wordmark size={19} class="lg:hidden" />
    <Wordmark size={20} class="max-lg:hidden" />
    <p class="text-sm text-muted-paper lg:max-w-[320px]">{t.footer.desc}</p>
  </div>
  <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2.5 lg:flex-col lg:gap-2.5">
    {
      // Rows whose target does not exist yet (terms / privacy until the legal pages are written) are not rendered.
      t.footer.links
        .filter((l) => l.href !== '#')
        .map((l) => (
          <a
            href={l.href.startsWith('#') ? `${home}${l.href}` : l.href}
            class="text-sm font-medium text-ink no-underline hover:text-plum"
          >
            {l.label}
          </a>
        ))
    }
  </nav>
  <div class="flex flex-col gap-1.5 text-[13px] lg:gap-2.5 lg:text-sm">
    <span class="hidden text-muted-paper lg:block">{t.footer.contact}</span>
    <a href={`mailto:${contact.email}`} class="font-medium text-plum no-underline">
      {contact.email}
    </a>
    <span class="text-muted-paper lg:mt-6">{t.footer.copyright}</span>
  </div>
</footer>
