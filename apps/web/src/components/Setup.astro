---
import { links } from '../config';
import type { Dictionary } from '../i18n';
import TableCard from './TableCard.astro';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="px-3 pb-14 lg:px-20 lg:pb-[88px] xl:px-[120px]">
  <div class="flex flex-col gap-[18px] overflow-hidden rounded-[20px] bg-dark px-6 py-10 text-paper lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16 lg:rounded-3xl lg:px-20 lg:py-[72px]">
    <div class="contents lg:flex lg:flex-col lg:gap-5">
      <p class="text-[11px] font-semibold tracking-[.08em] text-plum-light uppercase lg:text-xs">{t.setup.eyebrow}</p>
      <h2 class="text-[30px] leading-[1.12] tracking-[-.01em] lg:text-[44px]">{t.setup.h}</h2>
      <p class="text-base leading-[1.55] text-dark-text lg:text-lg">{t.setup.p}</p>
      <!-- stack of printed table cards: mobile position, between text and list -->
      <div aria-hidden="true" class="relative my-2 h-[240px] lg:hidden">
        <TableCard
          size={190}
          table={`${t.guest.table} 8`}
          tagline={t.tagline}
          logo={t.setup.logo}
          class="absolute top-6 left-[100px] rotate-[6deg] opacity-80 shadow-[0_16px_40px_rgba(0,0,0,.4)]"
        />
        <TableCard
          size={190}
          table={`${t.guest.table} 7`}
          tagline={t.tagline}
          logo={t.setup.logo}
          class="absolute top-2.5 left-[60px] rotate-[-4deg] shadow-[0_24px_50px_rgba(0,0,0,.5)]"
        />
      </div>
      <ol class="mt-0 flex flex-col border-t border-paper/15 lg:mt-2">
        {t.setup.list.map((label, i) => (
          <li class="flex items-center gap-3.5 border-b border-paper/15 py-3.5 lg:gap-4">
            <span class="w-[18px] font-serif text-[13px] text-plum-light tabular lg:w-5 lg:text-sm" aria-hidden="true">
              {i + 1}
            </span>
            <span class="text-[15px] font-medium lg:text-base">{label}</span>
          </li>
        ))}
      </ol>
      <div class="mt-1.5 flex flex-col gap-2 lg:mt-2 lg:flex-row lg:items-center lg:gap-5">
        <a href={links.quote} class="btn btn-paper h-12 px-[22px] text-[15px]">
          {t.setup.cta}
        </a>
        <p class="text-center text-[13px] text-faint lg:text-left lg:text-sm">{t.setup.price}</p>
      </div>
    </div>
    <!-- stack of printed table cards: desktop -->
    <div aria-hidden="true" class="relative hidden h-[460px] lg:block">
      <TableCard
        size={290}
        table={`${t.guest.table} 9`}
        tagline={t.tagline}
        logo={t.setup.logo}
        class="absolute top-[88px] left-[160px] rotate-[8deg] opacity-60 shadow-[0_20px_50px_rgba(0,0,0,.4)]"
      />
      <TableCard
        size={290}
        table={`${t.guest.table} 8`}
        tagline={t.tagline}
        logo={t.setup.logo}
        class="absolute top-[64px] left-[125px] rotate-[3deg] opacity-85 shadow-[0_20px_50px_rgba(0,0,0,.4)]"
      />
      <TableCard
        size={290}
        table={`${t.guest.table} 7`}
        tagline={t.tagline}
        logo={t.setup.logo}
        class="absolute top-10 left-[90px] rotate-[-4deg] shadow-[0_30px_60px_rgba(0,0,0,.5)]"
      />
    </div>
  </div>
</section>
