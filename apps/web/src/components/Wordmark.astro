---
import Mark from './Mark.astro';

/** Mark + "otvori" in Libre Baskerville 400 (brand lockup). `size` is the wordmark font size; the mark is 1.125× it. */
interface Props {
  size?: number;
  color?: string;
  class?: string;
}
const { size = 24, color = '#7A3E48', class: className } = Astro.props;
---

<span class:list={['inline-flex items-center', className]} style={`gap:${Math.round(size * 0.4)}px;color:${color}`}>
  <Mark size={Math.round(size * 1.125)} />
  <span class="font-serif leading-none tracking-[-.02em]" style={`font-size:${size}px`}>
    otvori
  </span>
</span>
