---
import { links } from '../config';
import type { Dictionary } from '../i18n';
import Mark from './Mark.astro';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="px-3 pb-10 lg:px-16 lg:pb-16">
  <div class="relative flex flex-col items-center gap-[18px] overflow-hidden rounded-[20px] border-l-[6px] border-plum-light bg-plum px-6 py-[52px] text-center text-white lg:gap-6 lg:rounded-3xl lg:border-l-8 lg:px-20 lg:py-24">
    <!-- the mark, oversized and faint, opening out of the right edge -->
    <Mark
      size={420}
      class="pointer-events-none absolute top-1/2 right-[-140px] -translate-y-1/2 text-white opacity-[.07] lg:right-[-60px] lg:size-[560px]"
    />
    <h2 class="relative text-[32px] leading-[1.12] tracking-[-.015em] lg:max-w-[760px] lg:text-[52px] lg:leading-[1.1]">
      {t.cta.h}
    </h2>
    <p class="relative text-[15px] text-plum-pale lg:text-lg">{t.hero.note}</p>
    <a
      href={links.register}
      class="btn btn-white relative mt-1 h-[50px] w-full text-base lg:mt-2 lg:h-[52px] lg:w-auto lg:px-7"
    >
      {t.nav.tryFree}
    </a>
  </div>
</section>
