---
import { contact } from '../config';
import type { Dictionary } from '../i18n';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section
  id="pitanja"
  class="scroll-mt-16 px-5 py-14 lg:grid lg:scroll-mt-[72px] lg:grid-cols-[380px_1fr] lg:items-start lg:gap-20 lg:px-20 lg:py-[88px] xl:px-[120px]"
>
  <div class="mb-5 flex flex-col gap-2.5 lg:mb-0 lg:gap-3">
    <p class="text-[11px] font-semibold tracking-[.08em] text-plum uppercase lg:text-xs">{t.nav.faq}</p>
    <h2 class="text-[28px] leading-[1.15] tracking-[-.01em] lg:text-[38px]">{t.faq.h}</h2>
    <p class="hidden text-muted-paper lg:block">
      {t.faq.sub}
      <a href={`mailto:${contact.email}`} class="font-medium text-plum no-underline">
        {contact.email}
      </a>
    </p>
  </div>
  <div class="flex flex-col border-t border-line-strong" data-faq>
    {t.faq.items.map((item, i) => (
      <div class="border-b border-line-strong">
        <h3 class="m-0">
          <button
            type="button"
            class="flex min-h-14 w-full cursor-pointer items-center justify-between gap-4 bg-transparent py-4 text-left text-base leading-[1.3] font-semibold text-ink lg:gap-6 lg:py-[22px] lg:text-lg lg:tracking-[-.01em]"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`faq-${i}`}
            id={`faq-${i}-btn`}
          >
            {item.q}
            <span
              class="faq-icon grid size-[26px] flex-none place-items-center rounded-full border border-line-strong lg:size-7"
              aria-hidden="true"
            >
              <svg
                width="11"
                height="11"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                class="lg:size-3"
              >
                <path d="M8 3v10M3 8h10" />
              </svg>
            </span>
          </button>
        </h3>
        <div
          id={`faq-${i}`}
          role="region"
          aria-labelledby={`faq-${i}-btn`}
          hidden={i !== 0}
          class="pr-10 pb-[18px] text-[15px] leading-[1.55] text-ink-2 lg:pr-[60px] lg:pb-6 lg:text-base lg:leading-relaxed"
        >
          {item.a}
        </div>
      </div>
    ))}
  </div>
</section>
