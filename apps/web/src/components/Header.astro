---
import { links } from '../config';
import { localePath, otherLocale, type Dictionary, type Locale } from '../i18n';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;
const other = otherLocale(locale);
const home = localePath(locale);
const nav = [
  { href: '#kako', label: t.nav.how },
  { href: '#dobijas', label: t.nav.features },
  { href: '#cene', label: t.nav.pricing },
  { href: '#pitanja', label: t.nav.faq },
];
---

<header class="relative border-b border-ink/8">
  <div class="flex h-[60px] items-center justify-between px-4 lg:h-[72px] lg:px-20 xl:px-[120px]">
    <a href={home} class="inline-flex items-center no-underline" aria-label={`${t.nav.menu}: salveta`}>
      <Wordmark size={21} gap={6} class="lg:hidden" />
      <Wordmark size={24} gap={8} class="max-lg:hidden" />
    </a>

    <nav aria-label="Primary" class="hidden gap-8 lg:flex">
      {nav.map((item) => (
        <a href={item.href} class="text-[15px] font-medium text-ink no-underline hover:text-plum">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 lg:gap-5">
      <a
        href={localePath(other)}
        hreflang={other}
        lang={other}
        data-lang-switch
        class="lang-switch inline-flex h-9 items-center gap-1 rounded-lg border border-line bg-white px-2.5 text-xs font-semibold text-ink no-underline lg:gap-[5px]"
      >
        <span data-active={locale === 'sr' ? 'true' : 'false'}>SR</span>
        <span class="font-normal text-faint" aria-hidden="true">
          /
        </span>
        <span data-active={locale === 'en' ? 'true' : 'false'}>EN</span>
        <span class="sr-only">— {other === 'sr' ? t.langSwitch.sr : t.langSwitch.en}</span>
      </a>
      <a href={links.signIn} class="hidden text-[15px] font-medium text-ink no-underline hover:text-plum lg:inline">
        {t.nav.signIn}
      </a>
      <a
        href={links.register}
        class="btn btn-plum h-9 rounded-lg px-3 text-[13px] lg:h-10 lg:rounded-[10px] lg:px-[18px] lg:text-sm"
      >
        {t.nav.tryFree}
      </a>
      <button
        type="button"
        class="grid size-9 place-items-center rounded-lg text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label={t.nav.menu}
        data-nav-toggle
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="nav-open-icon" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="nav-close-icon hidden" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Primary"
    hidden
    class="absolute inset-x-0 top-full z-20 border-b border-line bg-paper px-4 pt-2 pb-4 shadow-card lg:hidden"
  >
    <ul class="flex flex-col">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class="flex h-12 items-center border-b border-ink/8 text-base font-medium text-ink no-underline"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={links.signIn} class="flex h-12 items-center text-base font-medium text-plum no-underline">
          {t.nav.signIn}
        </a>
      </li>
    </ul>
  </nav>
</header>
