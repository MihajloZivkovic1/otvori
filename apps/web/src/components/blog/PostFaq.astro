---
/** The post's FAQ from its frontmatter: same accordion markup and script as the landing FAQ (scripts/faq.ts). */
import type { Dictionary } from '../../i18n';
interface Props {
  items: { q: string; a: string }[];
  t: Dictionary;
}
const { items, t } = Astro.props;
---

<section aria-labelledby="post-faq-h" class="mt-12 lg:mt-16">
  <h2 id="post-faq-h" class="mb-4 text-[26px] leading-[1.15] tracking-[-.01em] lg:mb-6 lg:text-[32px]">
    {t.blog.faq}
  </h2>
  <div class="flex flex-col border-t border-line-strong" data-faq>
    {items.map((item, i) => (
      <div class="border-b border-line-strong">
        <h3 class="m-0 font-sans">
          <button
            type="button"
            class="flex min-h-14 w-full cursor-pointer items-center justify-between gap-4 bg-transparent py-4 text-left text-base leading-[1.3] font-semibold text-ink lg:gap-6 lg:py-5 lg:text-lg lg:tracking-[-.01em]"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`faq-${i}`}
            id={`faq-${i}-btn`}
          >
            {item.q}
            <span
              class="faq-icon grid size-[26px] flex-none place-items-center rounded-full border border-line-strong lg:size-7"
              aria-hidden="true"
            >
              <svg
                width="11"
                height="11"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                class="lg:size-3"
              >
                <path d="M8 3v10M3 8h10" />
              </svg>
            </span>
          </button>
        </h3>
        <div
          id={`faq-${i}`}
          role="region"
          aria-labelledby={`faq-${i}-btn`}
          hidden={i !== 0}
          class="pr-10 pb-[18px] text-[15px] leading-[1.55] text-ink-2 lg:pr-[60px] lg:pb-6 lg:text-base lg:leading-relaxed"
        >
          {item.a}
        </div>
      </div>
    ))}
  </div>
</section>
