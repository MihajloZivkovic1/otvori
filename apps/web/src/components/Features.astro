---
import { featurePayments } from '../features';
import type { Dictionary } from '../i18n';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
// payments: phone with a tick (only with FEATURE_PAYMENTS=true at build time)
const paymentsIcon = 'M8 3h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2ZM11 18h2M9.5 11l2 2 3.5-4';
const icons = [
  // price: pencil
  'M4 20h4L19 9a2 2 0 0 0-3-3L5 17v3ZM13 7l4 4',
  // not today: clock
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM12 7v5l3 2',
  // languages: globe
  'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z',
  // allergens: tag
  'M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8ZM7.5 7.5h.01',
  // branding: palette
  'M12 3a9 9 0 1 0 0 18c1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8h2.2A4.2 4.2 0 0 0 21 10.8C21 6.5 17 3 12 3ZM7.5 11.5h.01M10 7.5h.01M14.5 7.5h.01',
  // analytics: bars
  'M4 20V10M10 20V4M16 20v-7M22 20H2',
];
---

<section id="dobijas" class="scroll-mt-16 px-5 py-14 lg:scroll-mt-[72px] lg:px-20 lg:py-[88px] xl:px-[120px]">
  <div class="mb-7 flex flex-col gap-2.5 lg:mb-12 lg:gap-3">
    <p class="text-[11px] font-semibold tracking-[.08em] text-plum uppercase lg:text-xs">{t.nav.features}</p>
    <h2 class="text-[28px] leading-[1.15] tracking-[-.01em] lg:max-w-[640px] lg:text-[38px]">{t.features.h}</h2>
  </div>
  <ul class="flex flex-col gap-3.5 lg:grid lg:grid-cols-3 lg:gap-5">
    <!-- 1 · orders on the waiter's phone -->
    <li class="hinge-card flex flex-col gap-4 p-5 lg:col-span-2 lg:gap-[18px] lg:p-6">
      <div
        aria-hidden="true"
        class="relative h-[196px] overflow-hidden rounded-[10px] border border-line bg-[#FAFAFA] lg:h-[200px]"
      >
        <div class="absolute top-4 right-4 left-4 flex flex-col gap-2.5 rounded-[10px] border border-line bg-white p-3 shadow-[0_8px_24px_rgba(0,0,0,.06)] lg:top-5 lg:right-auto lg:left-6 lg:w-[360px] lg:p-3.5">
          <div class="flex items-center gap-2 text-[13px] lg:text-sm">
            <span class="font-semibold">{t.features.order.table}</span>
            <span class="text-muted tabular">#142</span>
            <span class="inline-flex h-5 items-center gap-1 rounded-full bg-plum-soft px-2 text-[10px] font-semibold text-plum lg:text-[11px]">
              <span class="size-1.5 rounded-full bg-plum"></span>
              {t.features.order.status}
            </span>
            <span class="ml-auto text-[11px] text-faint lg:text-xs">{t.features.order.time}</span>
          </div>
          <div class="flex flex-col gap-1 text-[12px] lg:text-[13px]">
            {t.features.order.lines.map((line) => (
              <span>{line}</span>
            ))}
            <span class="text-muted italic">{t.features.order.note}</span>
          </div>
          <div class="flex gap-2">
            <span class="inline-flex h-8 flex-1 items-center justify-center rounded-lg bg-plum text-xs font-semibold text-white lg:h-9 lg:text-[13px]">
              {t.features.order.accept}
            </span>
            <span class="inline-flex h-8 items-center justify-center rounded-lg border border-line-strong px-3 text-xs font-semibold text-ink lg:h-9 lg:text-[13px]">
              {t.features.order.reject}
            </span>
          </div>
        </div>
        <!-- a second card peeking from the right on desktop -->
        <div class="absolute top-9 right-[-60px] hidden w-[220px] flex-col gap-2 rounded-[10px] border border-line bg-white p-3.5 opacity-70 lg:flex">
          <div class="flex items-center gap-2 text-sm">
            <span class="font-semibold">{t.guest.table} 3</span>
            <span class="text-muted tabular">#141</span>
          </div>
          <span class="h-2.5 w-[70%] rounded bg-line-soft"></span>
          <span class="h-2.5 w-[45%] rounded bg-line-soft"></span>
        </div>
      </div>
      <div class="flex flex-col gap-1 lg:gap-1.5">
        <h3 class="text-[17px] font-semibold lg:text-lg lg:tracking-[-.01em]">{t.features.f1.title}</h3>
        <p class="text-sm text-muted lg:text-base">{t.features.f1.text}</p>
      </div>
    </li>
    <!-- 2 · call the waiter / bill -->
    <li class="hinge-card flex flex-col gap-4 p-5 lg:gap-[18px] lg:p-6">
      <div
        aria-hidden="true"
        class="relative h-[170px] overflow-hidden rounded-[10px] border border-line bg-[#FAFAFA] lg:h-[200px]"
      >
        <div class="absolute inset-x-4 bottom-0 flex h-[120px] flex-col justify-end gap-2.5 rounded-t-[14px] bg-paper px-3 pb-3 shadow-[0_-8px_24px_rgba(0,0,0,.06)] lg:inset-x-5 lg:h-[140px] lg:gap-3 lg:px-3.5 lg:pb-3.5">
          <span class="inline-flex h-6 items-center gap-1.5 self-center rounded-full bg-white px-2.5 text-[11px] font-medium text-ink shadow-[0_1px_2px_rgba(0,0,0,.08)] lg:text-xs">
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#7A3E48"
              stroke-width="2.5"
              stroke-linecap="round"
            >
              <path d="M5 12l5 5L20 7"></path>
            </svg>
            {t.features.call.notified}
          </span>
          <div class="flex gap-2">
            <span class="inline-flex h-10 flex-1 items-center justify-center rounded-xl border border-plum bg-white text-xs font-semibold text-plum lg:text-[13px]">
              {t.features.call.call}
            </span>
            <span class="inline-flex h-10 items-center justify-center rounded-xl border border-line-strong bg-white px-4 text-xs font-semibold text-ink lg:text-[13px]">
              {t.features.call.bill}
            </span>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-1 lg:gap-1.5">
        <h3 class="text-[17px] font-semibold lg:text-lg lg:tracking-[-.01em]">{t.features.f2.title}</h3>
        <p class="text-sm text-muted lg:text-base">{t.features.f2.text}</p>
      </div>
    </li>
    {featurePayments && (
      <li class="hinge-card flex items-start gap-4 p-5 lg:flex-col lg:gap-[18px] lg:p-6">
        <span
          class="grid size-10 flex-none place-items-center rounded-[10px] bg-plum-soft text-plum lg:size-11 lg:rounded-xl"
          aria-hidden="true"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lg:size-[22px]"
          >
            <path d={paymentsIcon} />
          </svg>
        </span>
        <div class="flex flex-col gap-1 lg:gap-1.5">
          <h3 class="text-[17px] font-semibold lg:text-lg lg:tracking-[-.01em]">{t.features.payments.title}</h3>
          <p class="text-sm text-muted lg:text-base">{t.features.payments.text}</p>
        </div>
      </li>
    )}
    {t.features.rest.map((f, i) => (
      <li class="hinge-card flex items-start gap-4 p-5 lg:flex-col lg:gap-[18px] lg:p-6">
        <span
          class="grid size-10 flex-none place-items-center rounded-[10px] bg-plum-soft text-plum lg:size-11 lg:rounded-xl"
          aria-hidden="true"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lg:size-[22px]"
          >
            <path d={icons[i]} />
          </svg>
        </span>
        <div class="flex flex-col gap-1 lg:gap-1.5">
          <h3 class="text-[17px] font-semibold lg:text-lg lg:tracking-[-.01em]">{f.title}</h3>
          <p class="text-sm text-muted lg:text-base">{f.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
