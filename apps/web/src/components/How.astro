---
import type { Dictionary } from '../i18n';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const rotations = ['-1.5deg', '1deg', '-.6deg'];
---

<section
  id="kako"
  class="scroll-mt-16 border-y border-line bg-white px-5 py-14 lg:scroll-mt-[72px] lg:px-20 lg:py-[88px] xl:px-[120px]"
>
  <div class="mb-7 flex flex-col gap-2.5 lg:mb-14 lg:gap-3">
    <p class="text-[11px] font-semibold tracking-[.08em] text-plum uppercase lg:text-xs">{t.nav.how}</p>
    <h2 class="text-[28px] leading-[1.15] tracking-[-.01em] lg:max-w-[640px] lg:text-[38px]">{t.how.h}</h2>
  </div>
  <ol class="flex flex-col gap-5 px-1.5 lg:grid lg:grid-cols-3 lg:gap-9 lg:px-5">
    {t.how.steps.map((step, i) => (
      <li
        class="napkin flex items-start gap-[18px] px-6 pt-6 pb-[22px] shadow-napkin-sm [--napkin-cut:28px] lg:aspect-square lg:flex-col lg:justify-between lg:gap-0 lg:px-9 lg:pt-9 lg:pb-8 lg:shadow-napkin lg:[--napkin-cut:40px]"
        style={`transform:rotate(${rotations[i]})`}
      >
        <span
          class="flex-none font-serif text-[40px] leading-none font-bold tracking-[-.03em] text-plum lg:text-[64px]"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <div class="flex flex-col gap-1.5 lg:gap-2.5">
          <h3 class="text-lg leading-[1.25] font-semibold tracking-[-.01em] lg:text-[21px]">{step.title}</h3>
          <p class="text-sm text-muted lg:text-base">{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
