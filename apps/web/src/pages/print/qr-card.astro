---
/**
 * Plain 90×90 mm table card, print-ready (@page 90mm 90mm, no margins): wordmark, venue logo slot, big QR, table
 * number, "Skeniraj. Otvori. Naruči." and the short link.
 * Query params: venue (name), logo (image URL), table (number/label), qr (URL to encode) or qrImage (ready image URL),
 * lang (sr|en), url (short link printed under the code; defaults to `qr` without the scheme).
 * Example: /print/qr-card/?venue=Kafeterija%20Dor%C4%87ol&table=7&qr=https://kafeterija.otvori.menu/t/7
 */
import Mark from '../../components/Mark.astro';
import Base from '../../layouts/Base.astro';
---

<Base locale="sr" seo={false} noindex title="otvori — QR kartica za sto" description="Print-ready 90×90 mm table card">
  <style is:global slot="head">
    @page {
      size: 90mm 90mm;
      margin: 0;
    }
    html,
    body {
      background: #fff;
      margin: 0;
    }
    @media print {
      body {
        width: 90mm;
        height: 90mm;
        overflow: hidden;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .screen-only {
        display: none !important;
      }
    }
  </style>
  <div class="screen-only flex flex-col items-center gap-4 p-6 text-center text-sm text-muted print:hidden">
    <p id="card-note"></p>
    <button type="button" id="print" class="btn btn-plum h-10 px-4">
      Print
    </button>
  </div>
  <div class="flex justify-center print:block">
    <div
      id="card"
      class="relative flex h-[90mm] w-[90mm] flex-col items-center justify-between overflow-hidden border-l-[1.2mm] border-plum bg-white p-[6mm] pl-[7mm] text-ink shadow-[0_1px_2px_rgba(0,0,0,.08)] print:shadow-none"
    >
      <div class="flex w-full items-center justify-between">
        <span class="inline-flex items-center gap-[1.6mm] text-plum">
          <Mark size={20} />
          <span class="font-serif text-[17px] leading-none tracking-[-.02em]">otvori</span>
        </span>
        <span
          id="logo-slot"
          class="grid size-[12mm] place-items-center overflow-hidden rounded-full border-[1.5px] border-dashed border-faint text-center text-[7px] font-semibold tracking-[.06em] text-muted"
        >
          <span id="logo-placeholder">TVOJ LOGO</span>
          <img id="logo" alt="" class="hidden size-full object-cover" width="45" height="45" />
        </span>
      </div>
      <div id="qr" class="size-[44mm]" aria-label="QR"></div>
      <div class="flex flex-col items-center gap-[1.4mm]">
        <span id="table" class="font-serif text-[24px] leading-none"></span>
        <span id="tagline" class="text-[10px] font-medium tracking-[.03em] text-muted"></span>
        <span id="url" class="text-[8px] font-medium tracking-[.04em] text-faint"></span>
      </div>
    </div>
  </div>

  <script>
    import { initQrCard } from '../../scripts/qr-card';
    initQrCard(document, new URLSearchParams(location.search));
  </script>
</Base>
