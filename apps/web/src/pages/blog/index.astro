---
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES, BLOG_PATH, publishedPosts, readingMinutes } from '../../blog';
import PostCard from '../../components/blog/PostCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { t as dict, localePath } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema } from '../../blog';

const locale = 'sr';
const t = dict(locale);
const site = Astro.site ?? new URL('https://otvori.menu');
const posts = publishedPosts(await getCollection('blog'));
const categories = BLOG_CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));
---

<Base
  locale={locale}
  landing={false}
  path={BLOG_PATH}
  title={`otvori — ${t.blog.title}`}
  description={t.blog.description}
  ogImage={new URL('/og-blog.png', site).href}
  jsonLd={[
    breadcrumbSchema(site, [
      { name: 'otvori', path: '/' },
      { name: t.blog.eyebrow, path: BLOG_PATH },
    ]),
  ]}
>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`otvori — ${t.blog.eyebrow}`}
    href="/blog/rss.xml"
  />
  <Header locale={locale} t={t} onLanding={false} />
  <main class="mx-auto w-full max-w-[880px] px-5 pt-10 pb-16 lg:px-8 lg:pt-16 lg:pb-24">
    <p class="text-[11px] font-semibold tracking-[.08em] text-plum uppercase lg:text-xs">{t.blog.eyebrow}</p>
    <h1 class="mt-2.5 text-[32px] leading-[1.12] tracking-[-.015em] lg:text-[48px] lg:leading-[1.08]">{t.blog.h}</h1>
    <p class="mt-3 max-w-[600px] text-[17px] text-muted-paper lg:text-xl">{t.blog.description}</p>

    {categories.length > 0 ? (
      <nav aria-label={t.blog.categories.smena} class="mt-7 flex flex-wrap gap-2 lg:mt-9">
        {categories.map((c) => (
          <a
            href={`#${c}`}
            class="inline-flex h-9 items-center rounded-lg border border-line bg-white px-3 text-[13px] font-semibold text-ink no-underline hover:text-plum"
          >
            {t.blog.categories[c]}
          </a>
        ))}
        <a
          href="/blog/rss.xml"
          class="inline-flex h-9 items-center rounded-lg border border-line bg-white px-3 text-[13px] font-semibold text-muted no-underline hover:text-plum"
        >
          {t.blog.rss}
        </a>
      </nav>
    ) : (
      <p class="mt-10 text-muted-paper">{t.blog.empty}</p>
    )}

    {categories.map((c) => (
      <section id={c} class="mt-10 scroll-mt-16 lg:mt-14 lg:scroll-mt-[72px]" aria-labelledby={`cat-${c}`}>
        <h2 id={`cat-${c}`} class="mb-4 font-sans text-sm font-semibold tracking-[.06em] text-muted-paper uppercase">
          {t.blog.categories[c]}
        </h2>
        <ul class="flex flex-col gap-4 lg:gap-5">
          {posts
            .filter((p) => p.data.category === c)
            .map((p) => (
              <PostCard post={p.data} minutes={readingMinutes(p.body ?? '')} t={t} />
            ))}
        </ul>
      </section>
    ))}
    <p class="mt-10 text-sm text-muted-paper">
      <a href={localePath(locale)} class="font-medium text-plum no-underline">
        ← otvori.menu
      </a>
    </p>
  </main>
  <Footer t={t} home={localePath(locale)} />
</Base>
