# otvori production routing. DOMAIN, ACME_EMAIL and CF_API_TOKEN come from the container environment.
# Keep deploy/Caddyfile.local (the laptop variant with self-signed certificates) in sync when changing routes.
{
	email {$ACME_EMAIL}
	admin off
	# Every certificate — apex, app., api. and the *.DOMAIN wildcard — through the Cloudflare DNS-01 challenge,
	# so it also works while Cloudflare proxies a record or before port 80 is reachable.
	acme_dns cloudflare {$CF_API_TOKEN}
}

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Minimal CSP that every app already satisfies (no framing, no plugins, no <base> hijack). A full
		# script-src/style-src policy needs the inline handlers/styles hashed first — see docs/PRE-DEPLOY-AUDIT.md.
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		-Server
	}
}

# /api and locally stored uploads go to the API container (CORS is decided by the API's allowlist).
# Node closes idle keep-alive sockets after 65 s (apps/api/src/index.ts); Caddy must give up on an idle upstream
# connection first, otherwise a request can land on a socket the API is closing and 502.
(upstream) {
	transport http {
		keepalive 50s
	}
}

(api_proxy) {
	# Uploads are capped at 8 MB by the API; stop larger bodies at the edge.
	request_body {
		max_size 10MB
	}
	# Server-Sent Events for the waiter screen (GET …/events?token=): streamed, never buffered. Caddy already
	# flushes text/event-stream responses immediately; flush_interval -1 makes that explicit. `encode` skips the
	# stream because the API sends `Cache-Control: no-transform` (Caddy honours it), so nothing re-buffers it.
	handle /api/admin/restaurants/*/events {
		reverse_proxy api:3000 {
			flush_interval -1
			import upstream
		}
	}
	handle /api/* {
		reverse_proxy api:3000 {
			import upstream
		}
	}
	handle /uploads/* {
		reverse_proxy api:3000 {
			import upstream
		}
	}
}

# Vite single-page apps: hashed files under /assets are immutable, everything else revalidates so deploys show up.
# Wrapped in a fallback `handle` so the more specific `handle /api/*` blocks win: a bare try_files would rewrite
# /api/… to /index.html before the proxy matcher is evaluated.
(spa) {
	handle {
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry not path /assets/*
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Apex: the marketing site (apps/web, Astro static output). Pretty URLs end with a slash.
{$DOMAIN} {
	import security
	header X-Frame-Options DENY
	encode zstd gzip
	root * /srv/web
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=2592000"
	@pages not path /_astro/* /fonts/* /icons/* /favicon.* /og-*.png /robots.txt /sitemap*.xml
	header @pages Cache-Control "public, max-age=300"
	try_files {path} {path}/index.html
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Admin CMS: same-origin /api so the refresh cookie stays first-party.
app.{$DOMAIN} {
	import security
	header X-Frame-Options DENY
	# The admin is never search content; the SPA shell also carries <meta name="robots" content="noindex">.
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	import api_proxy
	root * /srv/cms
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	import spa
}

# API for direct access (curl, webhooks, the uploads fallback). TLS ends here; the API sees X-Forwarded-* (TRUST_PROXY=1).
api.{$DOMAIN} {
	import security
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	request_body {
		max_size 10MB
	}
	# SSE stream (see api_proxy): explicit low-latency mode; `no-transform` from the API keeps `encode` away.
	@sse path /api/admin/restaurants/*/events
	reverse_proxy @sse api:3000 {
		flush_interval -1
		import upstream
	}
	reverse_proxy api:3000 {
		import upstream
	}
}

# Public menus: {slug}.DOMAIN (wildcard certificate). The menu app preloads /api/public/menu on its own origin.
*.{$DOMAIN} {
	import security
	header X-Frame-Options DENY
	# Guest menus are reached from the QR code, not from search; keeps venue menus out of the index (meta robots too).
	header X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	import api_proxy
	root * /srv/menu
	import spa
}
