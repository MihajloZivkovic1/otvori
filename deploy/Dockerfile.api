# Build context: repository root. Built by .github/workflows/deploy.yml (never on the droplet) and pushed to
# ghcr.io/<owner>/otvori-api:<git short sha>. Produces the Express API with @qr-menu/shared compiled in.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json turbo.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/menu/package.json apps/menu/
COPY apps/cms/package.json apps/cms/
COPY apps/web/package.json apps/web/
RUN npm ci --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/api apps/api
RUN npm run build -w @qr-menu/shared && npm run build -w @qr-menu/api

# Runtime: production dependencies of api + shared only. In a workspace tree `npm ci --omit=dev` (with or without -w)
# still installs every other workspace's production deps (react, astro → vite …) and `npm prune` cannot drop them either,
# so the root manifest is narrowed to the two workspaces and the lockfile trimmed to match — pinned versions are kept.
FROM node:22-alpine
ARG APP_VERSION=dev
ARG SOURCE_URL=https://github.com/MihajloZivkovic1/otvori
LABEL org.opencontainers.image.source=$SOURCE_URL org.opencontainers.image.revision=$APP_VERSION
ENV NODE_ENV=production APP_VERSION=$APP_VERSION
WORKDIR /app
COPY package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
RUN printf '{"name":"otvori-api-runtime","private":true,"workspaces":["apps/api","packages/shared"]}\n' > package.json \
 && npm install --package-lock-only --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm ci --omit=dev --no-audit --no-fund \
 && npm cache clean --force
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/api/dist apps/api/dist
COPY apps/api/assets apps/api/assets
RUN mkdir -p /app/apps/api/uploads && chown -R node:node /app/apps/api/uploads
USER node
WORKDIR /app/apps/api
EXPOSE 3000
# node is PID 1 so SIGTERM from `docker stop` reaches the graceful shutdown handler directly.
# Pending migrations run inside the process before it listens (MIGRATE_ON_START, on by default in production).
CMD ["node", "dist/index.js"]
