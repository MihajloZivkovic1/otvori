# Copy to deploy/.env. Everything is read by docker-compose.yml.
DOMAIN=salveta.menu
ACME_EMAIL=zdravo@salveta.menu
# Cloudflare API token with Zone:DNS:Edit on the zone (wildcard certificate for *.DOMAIN).
CLOUDFLARE_API_TOKEN=
# Optional cookieless analytics for the marketing site (Plausible-style script tag). Empty = none.
PUBLIC_ANALYTICS_SRC=
PUBLIC_ANALYTICS_DOMAIN=

POSTGRES_USER=salveta
POSTGRES_PASSWORD=
POSTGRES_DB=salveta

# openssl rand -base64 48
JWT_ACCESS_SECRET=
LOG_LEVEL=info
MAIL_FROM="salveta <no-reply@salveta.menu>"

# Optional S3-compatible storage (DigitalOcean Spaces). Empty = uploads volume on disk.
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_REGION=fra1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
