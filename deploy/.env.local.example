# Laptop full-stack check (docker-compose.local.yml). Nothing here is secret.
DOMAIN=localhost
ACME_EMAIL=dev@localhost
CF_API_TOKEN=unused-locally
POSTGRES_PASSWORD=localpassword
JWT_ACCESS_SECRET=local-only-jwt-signing-key-0123456789abcdef0123456789abcdef
MAIL_PROVIDER=log
ALLOW_LOG_MAIL=1
PAYMENTS_ENCRYPTION_KEY=local-only-encryption-key-not-secret
# Production parity: online payment off, POS on (flip FEATURE_PAYMENTS=true to see the payment UI locally).
FEATURE_PAYMENTS=false
FEATURE_POS=true
LOG_LEVEL=info
