# ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
# otvori production environment. Copy to deploy/.env.prod on the droplet (chmod 600). Read by docker compose
# through deploy/deploy.sh (--env-file) and sourced by deploy/backup.sh / restore.sh. Never commit .env.prod.
# ───────────────────────────────────────────────────────────────────────────────────────────────────────────────

# ── Domain & TLS ──────────────────────────────────────────────────────────────────────────────────────────────
# Apex domain. Caddy serves DOMAIN (marketing), www (redirect), app (CMS), api (API) and *.DOMAIN (public menus).
# Also a build argument of the Caddy image (the marketing site's canonical URLs) — see .github/workflows/deploy.yml.
DOMAIN=otvori.menu
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=zdravo@otvori.menu
# Cloudflare API token with permissions  Zone → DNS → Edit  and  Zone → Zone → Read  for the otvori.menu zone only.
# Used for the DNS-01 challenge (every certificate, including the *.otvori.menu wildcard).
CF_API_TOKEN=replace-me

# ── Images ────────────────────────────────────────────────────────────────────────────────────────────────────
# GitHub user/org that owns the packages ghcr.io/<owner>/otvori-api and otvori-caddy (lowercase).
GHCR_OWNER=mihajlozivkovic1
# Image tag to run: a git short SHA pushed by the Deploy workflow, or "latest". deploy.sh <tag> overrides it per run.
IMAGE_TAG=latest

# ── Database (the postgres container; nothing is exposed outside the compose network) ─────────────────────────
# The database role and name keep the historical "salveta": the data volume was initialised with them.
POSTGRES_USER=salveta
POSTGRES_DB=salveta
# Generate with:  openssl rand -hex 32   (hex only — it is embedded in DATABASE_URL, so no / + = characters)
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-32

# ── API ───────────────────────────────────────────────────────────────────────────────────────────────────────
# Signs the 15-minute access tokens. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-48
# pino level for the API: info in production, debug while troubleshooting.
LOG_LEVEL=info

# ── Mail (magic links, password resets) ───────────────────────────────────────────────────────────────────────
# resend = send through https://resend.com. `log` only writes mails (with their secret links) to the API log and is
# refused in production unless ALLOW_LOG_MAIL=1 is set as well — use it only for the very first smoke test.
MAIL_PROVIDER=resend
# Resend API key (https://resend.com/api-keys) for a domain you verified there (otvori.menu).
RESEND_API_KEY=replace-me
# Sender shown to users; the domain must be verified in Resend.
MAIL_FROM=otvori <zdravo@otvori.menu>

# ── Object storage: AWS S3 bucket "otvori-media" in eu-central-1 ─────────────────────────────────────────────
# Public images are written under restaurants/<restaurantId>/… and made public by the BUCKET POLICY on restaurants/*
# (no per-object ACL — the bucket keeps "Bucket owner enforced"); backups go under backups/ and stay private.
# A dedicated IAM user (otvori-api) with a policy limited to this one bucket owns these keys (deploy/README.md § 2).
# Leave S3_BUCKET empty to keep uploads on the droplet's `uploads` volume instead (served at https://api.DOMAIN/uploads).
#
# S3_ENDPOINT stays EMPTY for AWS (the SDK uses the regional endpoint). Alternative — DigitalOcean Spaces or any
# S3-compatible service: set S3_ENDPOINT=https://fra1.digitaloceanspaces.com, S3_REGION=fra1, S3_BUCKET=<space>,
# S3_PUBLIC_BASE_URL=https://<space>.fra1.cdn.digitaloceanspaces.com; objects then get ACL public-read per upload.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=otvori-media
# Access keys of the IAM user otvori-api. Also used by backup.sh / restore.sh (as AWS_* credentials).
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Base of every public image URL: the bucket's own host, or a CDN/custom domain in front of it.
S3_PUBLIC_BASE_URL=https://otvori-media.s3.eu-central-1.amazonaws.com

# ── Backups (deploy/backup.sh) ────────────────────────────────────────────────────────────────────────────────
# Prefix inside the bucket for nightly pg_dump files and how many days to keep them.
BACKUP_PREFIX=backups
BACKUP_KEEP_DAYS=14

# ── Feature flags (Phase 10) ───────────────────────────────────────────────────────────────────────────────────
# Global switches above the per-venue modules. FEATURE_PAYMENTS=false hides online payment everywhere (no venue can
# have the module, payment routes and the bank webhook answer 404, no payment UI) — keep it false until the bank
# integration is released from the feature/payments branch. FEATURE_POS=true offers the Octopos integration to
# venues a superadmin switches it on for. Both are reported by GET /api/health and GET /api/config.
FEATURE_PAYMENTS=false
FEATURE_POS=true

# ── Secrets at rest / payment & POS integrations ─────────────────────────────────────────────────────────────
# Encrypts merchant secrets and POS API keys at rest (AES-256-GCM). Required even with payments off (POS keys use
# it). `openssl rand -base64 32`; changing it later makes every stored secret unreadable (venues re-enter them).
PAYMENTS_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32
# OTP eCommerce gateway base URL once the bank integration is live (leave empty until then; unused while
# FEATURE_PAYMENTS=false).
OTP_ECOM_BASE_URL=
# Octopos: nothing to set here. Each venue's register URL and API key are entered in the CMS (Settings →
# Integrations) and stored encrypted in restaurants.pos_config. OCTOPOS_SANDBOX_URL / OCTOPOS_SANDBOX_AUTH exist
# only for the API's live integration tests on a laptop and must stay unset in production.
# PAYMENTS_MOCK and POS_MOCK are ignored in production (forced to false by the API): the simulator and the mock
# register can never run here.
