# Build context: repository root. Built by .github/workflows/deploy.yml and pushed to ghcr.io/<owner>/otvori-caddy.
# Bundles the three static builds (menu, cms, web) and serves them with Caddy (TLS via Cloudflare DNS, wildcard included).
FROM node:22-alpine AS build
ARG DOMAIN=otvori.menu
# Git short SHA of the release: versions the CMS service-worker cache so every deploy evicts the previous shell.
ARG APP_VERSION=dev
WORKDIR /app
COPY package.json package-lock.json turbo.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/menu/package.json apps/menu/
COPY apps/cms/package.json apps/cms/
COPY apps/web/package.json apps/web/
RUN npm ci --no-audit --no-fund
COPY packages/shared packages/shared
COPY apps/menu apps/menu
COPY apps/cms apps/cms
COPY apps/web apps/web
RUN npm run build -w @qr-menu/shared
# Both apps call /api on their own origin; Caddy proxies it to the API container.
RUN VITE_API_URL= VITE_DEFAULT_SLUG= npm run build -w @qr-menu/menu
RUN VITE_API_URL= APP_VERSION="${APP_VERSION}" npm run build -w @qr-menu/cms
# Marketing site; SITE_URL feeds canonical/hreflang/sitemap, PUBLIC_ANALYTICS_* the optional analytics tag.
# FEATURE_PAYMENTS (default false, same as the API's flag) decides whether the online-payment copy is rendered.
ARG PUBLIC_ANALYTICS_SRC=
ARG PUBLIC_ANALYTICS_DOMAIN=
ARG FEATURE_PAYMENTS=false
RUN SITE_URL="https://${DOMAIN}" PUBLIC_FEATURE_PAYMENTS="${FEATURE_PAYMENTS}" npm run build -w @qr-menu/web

# Caddy with the Cloudflare DNS module (ACME DNS-01 for every certificate, including *.DOMAIN).
FROM caddy:2-builder AS caddy-build
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
ARG SOURCE_URL=https://github.com/MihajloZivkovic1/qr-menu
LABEL org.opencontainers.image.source=$SOURCE_URL
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY --from=build /app/apps/menu/dist /srv/menu
COPY --from=build /app/apps/cms/dist /srv/cms
COPY --from=build /app/apps/web/dist /srv/web
COPY deploy/Caddyfile /etc/caddy/Caddyfile
